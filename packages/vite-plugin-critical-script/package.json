{
  "name": "@woowabros/vite-plugin-critical-script",
  "version": "0.1.0",
  "description": "Vite plugin to inline TypeScript modules as critical HTML scripts that run before the main JS bundle — for API prefetch, asset preload, webview bridge, LCP optimization",
  "keywords": [
    "vite",
    "vite-plugin",
    "critical",
    "critical-script",
    "inline-script",
    "prefetch",
    "preload",
    "webview",
    "lcp",
    "performance",
    "react-router",
    "tanstack-start"
  ],
  "homepage": "https://github.com/woowabros/critical-script#readme",
  "bugs": "https://github.com/woowabros/critical-script/issues",
  "license": "MIT",
  "author": "Woowa Brothers (https://github.com/woowabros)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woowabros/critical-script.git",
    "directory": "packages/vite-plugin-critical-script"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "vitest run",
    "prepack": "node scripts/pack-assets.mjs prepare"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "dedent": "1.7.2",
    "esbuild": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "0.20.1",
    "typescript": "catalog:",
    "vite": "5.4.21",
    "vitest": "3.2.6"
  },
  "peerDependencies": {
    "@types/react": "^17 || ^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
