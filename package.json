{
  "name": "critical-script",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "if [[ -x \"$(command -v husky)\" ]]; then husky install; fi",
    "lint-staged": "lint-staged",
    "sbom": "rm -rf _artifacts/sbom && mkdir -p _artifacts/sbom && cdxgen --type js --format cyclonedx --json-pretty --output _artifacts/sbom/sbom.cyclonedx.json && cdxgen --type js --format spdx --json-pretty --output _artifacts/sbom/sbom.spdx.json"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.15.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.1.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@cyclonedx/cdxgen": "12.8.2",
    "@eslint/js": "9.39.2",
    "@types/node": "catalog:",
    "@vitest/eslint-plugin": "1.6.24",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.9.6",
    "typescript": "catalog:",
    "typescript-eslint": "8.65.0"
  },
  "lint-staged": {
    "!(*.d).{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{json,js,jsx,mjs}": [
      "prettier --write"
    ]
  }
}
